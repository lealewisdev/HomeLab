vars: {
  d2-config: {
    theme-id: 200
    theme-overrides: {
      N1: "#C6D0F5"  # Text
      N2: "#B5BFE2"  # Subtext1
      N3: "#A5ADCE"  # Subtext0
      N4: "#626880"  # Surface2
      N5: "#51576D"  # Surface1
      N6: "#414559"  # Surface0
      N7: "#303446"  # Base

      B1: "#CA9EE6"  # Mauve
      B2: "#CA9EE6"  # Mauve
      B3: "#737994"  # Overlay0
      B4: "#626880"  # Surface2
      B5: "#51576D"  # Surface1
      B6: "#414559"  # Surface0

      AA2: "#E78284"  # Red
      AA4: "#51576D"  # Surface1
      AA5: "#414559"  # Surface0

      AB4: "#51576D"  # Surface1
      AB5: "#414559"  # Surface0
    }
  }
  frappe: {
    _text: "#C6D0F5"
    rosewater: "#F2D5CF"
    flamingo:  "#EEBEBE"
    pink:      "#F4B8E4"
    mauve:     "#CA9EE6"
    red:       "#E78284"
    maroon:    "#EA999C"
    peach:     "#EF9F76"
    yellow:    "#E5C890"
    green:     "#A6D189"
    teal:      "#81C8BE"
    sky:       "#99D1DB"
    sapphire:  "#85C1DC"
    blue:      "#8CAAEE"
    lavender:  "#BABBF1"
  }
}

classes: {
  rosewater: {
    style: {
      font-color: ${frappe.rosewater}
      stroke: ${frappe.rosewater}
    }
  }
  flamingo: {
    style: {
      font-color: ${frappe.flamingo}
      stroke: ${frappe.flamingo}
    }
  }
  pink: {
    style: {
      font-color: ${frappe.pink}
      stroke: ${frappe.pink}
    }
  }
  mauve: {
    style: {
      font-color: ${frappe.mauve}
      stroke: ${frappe.mauve}
    }
  }
  red: {
    style: {
      font-color: ${frappe.red}
      stroke: ${frappe.red}
    }
  }
  maroon: {
    style: {
      font-color: ${frappe.maroon}
      stroke: ${frappe.maroon}
    }
  }
  peach: {
    style: {
      font-color: ${frappe.peach}
      stroke: ${frappe.peach}
    }
  }
  yellow: {
    style: {
      font-color: ${frappe.yellow}
      stroke: ${frappe.yellow}
    }
  }
  green: {
    style: {
      font-color: ${frappe.green}
      stroke: ${frappe.green}
    }
  }
  teal: {
    style: {
      font-color: ${frappe.teal}
      stroke: ${frappe.teal}
    }
  }
  sky: {
    style: {
      font-color: ${frappe.sky}
      stroke: ${frappe.sky}
    }
  }
  sapphire: {
    style: {
      font-color: ${frappe.sapphire}
      stroke: ${frappe.sapphire}
    }
  }
  blue: {
    style: {
      font-color: ${frappe.blue}
      stroke: ${frappe.blue}
    }
  }
  lavender: {
    style: {
      font-color: ${frappe.lavender}
      stroke: ${frappe.lavender}
    }
  }
  invisible: {
    style.opacity: 0
    label: a
  }
}
(*** -> ***)[*]: {
  style.border-radius: 999
}
direction: down
internet: Internet {
  shape: cloud
  style: {
    font-size: 35
    bold: true
  }
}
router: {
  style: {
    font-size: 35
    bold: true
  }
}
internet -> router
router -> internet:VPN
router -> nixos
nixos.**: {
  &leaf: true
  width: 350
  height: 50
  style.stroke-width: 0
}
nixos: {
  label: NixOs
  style: {
    font-size: 35
    bold: true
  }
  shape: rectangle
  grid-rows: 2
  grid-columns: 1
  vertical-gap: 0
  horizontal-gap: 25
  traefik_net: {
    label: ""
    grid-rows: 2
    grid-columns: 1
    vertical-gap: 10
    horizontal-gap: 0
    style: {
      font-size: 25
      bold: true
    }

    header_row: {
      label: ""
      grid-rows: 1
      grid-columns: 3
      horizontal-gap: 0
      vertical-gap: 0
      height: 60
      style: {
        fill: transparent
        stroke-width: 0
      }

      lefty: {
        width: 1812
        height: 100
        style.opacity: 0
      }

      this_icon: {
        label: "Networks: [traefik/traefik]"
        label.near: top-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/traefik-light.svg
        icon.near: center-left
        width: 500
        height: 100
        style: {
          fill: transparent
          font-size: 25
          bold: true
        }
      }

      right: {
        width: 1813
        style.opacity: 0
      }
    }

    body: {
      label: ""
      grid-rows: 1
      grid-columns: 6
      vertical-gap: 0
      horizontal-gap: 25
      style: {
        fill: transparent
        stroke-width: 0
      }
      observability: Observability {
        style: {
          font-size: 25
          bold: true
        }
        grid-rows: 7
        grid-columns: 1
        horizontal-gap: 25
        vertical-gap: 25
        victorialogs: "victoriametrics/victoria-logs" {
