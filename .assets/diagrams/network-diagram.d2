          byparr: "alpine-base*" {
            width: 350
            icon.near: center-left
            label.near: center-center
            icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/alpine-linux-light.svg
          }
        }
      }
    }
  }
  row2: {
    grid-rows: 1
    vertical-gap: 0
    horizontal-gap: 43
    style: {
      opacity: 0
    }
    data_net: {
      label: "Networks: [Data]"
      style: {
        font-size: 25
        bold: true
      }
      shape: rectangle
      grid-rows: 1
      grid-columns: 5
      horizontal-gap: 25
      vertical-gap: 25
      mariadb: "linuxserver/mariadb" {
        shape: cylinder
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/mariadb-light.svg
        style: {
          stroke-width: 2
          stroke: ${frappe._text}
        }
        width: 300
        height: 100
      }
      obsidian: "couchdb" {
        shape: cylinder
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/couchdb-light.svg
        style: {
          stroke-width: 2
          stroke: ${frappe._text}
        }
        width: 300
        height: 100
      }
      meili: "getmeili/meilisearch" {
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/meilisearch-light.svg
        shape: cylinder
        style.stroke-width: 2
        class: pink
        width: 300
        height: 100
      }
      redis: "valkey/valkey" {
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/valkey-light.svg
        shape: cylinder
        style.stroke-width: 2
        class: peach
        width: 300
        height: 100
      }
      postgres: "immich-app/postgres*" {
        shape: cylinder
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/postgresql-light.svg
        class: green
        style: {
          stroke-width: 2
        }
        width: 300
        height: 100
      }
    }
    wings0_net: {
      label: "Networks: [Wings0]"
      style: {
        font-size: 25
        bold: true
      }
      shape: rectangle
      wings: "pelican/wings" {
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/pelican-panel-light.svg
      }
      grid-rows: 1
      grid-columns: 1
      horizontal-gap: 25
      vertical-gap: 75
    }
    default_net: {
      label: "Networks: [Default]"
      style: {
        font-size: 25
        bold: true
      }
      shape: rectangle
      grid-rows: 1
      grid-columns: 5
      horizontal-gap: 25
      vertical-gap: 75
      mosquitto: "eclipse-mosquitto" {
        class: green
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/mosquitto-light.svg
      }
      otbr: "openthread/border-router" {
        class: teal
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/thread-light.svg
      }
      beets: "linuxserver/beets" {
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/beets-light.svg
      }
      onnx: "tboby/wyoming-onnx-asr" {
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/nvidia-light.svg
      }
      piper: "linuxserver/piper" {
        icon.near: center-left
        label.near: center-center
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/piper-tts-light.svg
      }
    }
  }
}

legend: {
  label: "Datastore key"
  near: bottom-right
  grid-rows: 3
  grid-columns: 1
  vertical-gap: 8
  horizontal-gap: 0
  style: { font-size: 20; bold: true; fill: transparent; stroke-width: 0 }

  row_pg: {
    label: ""
    grid-rows: 1
    grid-columns: 2
    horizontal-gap: 10
    vertical-gap: 0
    style: { fill: transparent; stroke-width: 0 }
    dot: { label: ""; width: 16; height: 16; style: { fill: ${frappe.green}; stroke-width: 0; border-radius: 999 } }
    text: { label: "Postgres"; style: { font-color: ${frappe._text}; font-size: 20 } }
  }
  row_redis: {
    label: ""
    grid-rows: 1
    grid-columns: 2
    horizontal-gap: 10
    vertical-gap: 0
    style: { fill: transparent; stroke-width: 0 }
    dot: { label: ""; width: 16; height: 16; style: { fill: ${frappe.peach}; stroke-width: 0; border-radius: 999 } }
    text: { label: "Redis"; style: { font-color: ${frappe._text}; font-size: 20 } }
  }
  row_meili: {
    label: ""
    grid-rows: 1
    grid-columns: 2
    horizontal-gap: 10
    vertical-gap: 0
    style: { fill: transparent; stroke-width: 0 }
    dot: { label: ""; width: 16; height: 16; style: { fill: ${frappe.pink}; stroke-width: 0; border-radius: 999 } }
    text: { label: "Meilisearch"; style: { font-color: ${frappe._text}; font-size: 20 } }
  }
}
